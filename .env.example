# =============================================================================
# PostgreSQL — copy to novora_backend/.env (do not commit .env).
# Works with Neon, Supabase, local Postgres, or any managed Postgres.
# =============================================================================
# EnvFileLoader picks the first file that exists, in order:
#   1) $ENV_FILE (absolute path)
#   2) $PWD/.env
#   3) $PWD/novora_backend/.env   (when you run Maven from the monorepo root)
#   4) $PWD/backend/.env          (legacy folder name)
# OS environment variables override values from the file.
#
# Dashboard → Connect → JDBC / URI, then convert to jdbc:postgresql://…?sslmode=require
# Prefer a pooler host when the provider offers one (hostname often contains "pooler").

# --- Required ---
DB_URL=jdbc:postgresql://HOST:5432/DATABASE?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your_password

# --- Pool (serverless Postgres: start small; raise if needed) ---
DB_POOL_SIZE=5

# Plain HTTP API (http://127.0.0.1:8081) without Spring profile `local`:
# SERVER_SERVLET_SESSION_COOKIE_SECURE=false

# Hibernate schema mode (default `update`). Prefer `validate` or `none` on shared/prod DBs.
# JPA_DDL_AUTO=validate

# Full public-schema reset (dev only):
#   novora_backend/src/main/resources/db/manual/reset_neon_public_schema.sql

# --- Optional: bootstrap first admin on startup (only if user does not exist) ---
# APP_BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com
# APP_BOOTSTRAP_ADMIN_PASSWORD=choose-a-strong-password

# --- CORS (exact origins only; never https://*.vercel.app with credentials) ---
# APP_CORS_ADDITIONAL_ORIGIN_PATTERNS=https://novora-hrms.vercel.app

# --- Employee personal-profile OTP (mail not wired; codes logged at INFO) ---
# APP_OTP_TTL_SECONDS=600
# APP_OTP_RESEND_COOLDOWN_SECONDS=60
# Never enable in production — returns the OTP in the API response.
# APP_OTP_EXPOSE_CODE=false

# --- Firebase Authentication (optional — native mobile) ---
# Web admin uses cookie sessions (leave false).
# FIREBASE_ENABLED=true
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
